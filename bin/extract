#!/usr/bin/env ruby
# frozen_string_literal: true

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "bundler/setup"
require "json"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "google_search"

usage_error = 64
data_error = 65
input_error = 66

unless ARGV.one?
  warn "Usage: bin/extract HTML_FILE"
  exit usage_error
end

path = ARGV.fetch(0)

begin
  html = File.binread(path)
rescue SystemCallError
  warn "Could not read input file: #{path}"
  exit input_error
end

begin
  result = GoogleSearch::ArtworkExtractor.new(html).call
rescue GoogleSearch::Error => error
  warn "Extraction failed: #{error.message}"
  exit data_error
end

puts JSON.pretty_generate(result)
