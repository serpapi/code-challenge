$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "json"
require "serpapi_challenge/parser"

if ARGV.length < 1
  warn "Usage: ruby bin/parse <input.html> [output.json]"
  exit 1
end

input = ARGV[0]
output = ARGV[1] || "out/van-gogh-paintings.json"

parser = SerpapiChallenge::Parser.new
result = parser.parse_file(input)

out_dir = File.dirname(output)
Dir.mkdir(out_dir) unless Dir.exist?(out_dir)
File.write(output, JSON.pretty_generate(result), mode: "w")

puts "Wrote #{result.fetch('artworks', []).size} artworks to #{output}"
