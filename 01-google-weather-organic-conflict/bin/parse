#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "google_search_parser"
require "pp"

fixture = ARGV[0] || File.expand_path("../fixtures/weather_austin_desktop_2025_03_14.html", __dir__)
html = File.read(fixture)

pp GoogleSearchParser.new(html).parse
